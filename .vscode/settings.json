{
  // Oxlint (oxc.oxc-vscode extension) lints all JS/TS; ESLint only the frontend's Vue templates
  "eslint.validate": ["vue"],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.workingDirectories": [
    {
      "pattern": "./packages/frontend"
    }
  ],
  "oxc.enable": true,
  "stylelint.validate": ["css", "less", "postcss", "vue"],
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "js/ts.tsdk.path": "packages/backend/node_modules/typescript/lib"
}
